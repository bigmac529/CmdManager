<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS application /api of the cmdmanager.socha3.com site (C:\WebApps\CmdManager\api), app pool "CmdManager" with
  .NET CLR version "No Managed Code". ANCM passes PathBase=/api, so the app routes (/health, /auth/...) answer at /api/...
  dotnet publish fills in processPath/arguments for in-process hosting (ASP.NET Core Hosting Bundle 10).
  requestLimits must be >= Library:MaxRequestBytes (default ~141 MB for a 100 MB file limit); IIS rejects
  larger bodies with 404.13 before they reach the app.
  WebDAV: when the IIS WebDAV Publishing feature is installed on the server, its module and handler grab PUT and
  DELETE before ASP.NET Core sees them and answer "405 - HTTP verb used to access this page is not allowed"
  (IIS HTML page, Allow: GET, HEAD, OPTIONS, TRACE). That broke every save/replace/rename/delete. Both are removed
  for this application only (the site root is unaffected). Pinned by tests/CmdManager.Api.Tests/WebConfigTests.cs.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\CmdManager.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- 200 MB -->
          <requestLimits maxAllowedContentLength="209715200" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
