<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site "CmdManager" (C:\WebApps\CmdManager), app pool "CmdManager" with .NET CLR version "No Managed Code".
  dotnet publish fills in processPath/arguments for in-process hosting (ASP.NET Core Hosting Bundle 10).
  requestLimits must be >= Library:MaxRequestBytes (default ~141 MB for a 100 MB file limit); IIS rejects
  larger bodies with 404.13 before they reach the app.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\CmdManager.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- 200 MB -->
          <requestLimits maxAllowedContentLength="209715200" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
