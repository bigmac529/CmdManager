{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CmdManager": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Key": "",
    "Issuer": "CmdManager",
    "Audience": "CmdManager.Client",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "Auth": {
    "AllowRegistration": true,
    "MinPasswordLength": 8,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 5,
    "RateLimitPerMinute": 30
  },
  "Library": {
    "MaxFileBytes": 104857600,
    "MaxRequestBytes": 0
  }
}
