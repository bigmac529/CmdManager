<Window x:Class="CmdManager.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CmdManager - Log in" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="CmdManager" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Log in to your command library." Margin="0,0,0,12" Foreground="Gray" />

        <TextBlock x:Name="MessageText" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />

        <TextBlock Text="API URL (e.g. https://cmdmanager.socha3.com/api/)" />
        <TextBox x:Name="ServerBox" />
        <TextBlock Text="User name" Margin="0,6,0,0" />
        <TextBox x:Name="UserBox" />
        <TextBlock Text="Password" Margin="0,6,0,0" />
        <PasswordBox x:Name="PasswordBox" />

        <DockPanel Margin="0,12,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center">
                <Hyperlink x:Name="CreateAccountLink" Click="CreateAccount_Click">Create account</Hyperlink>
            </TextBlock>
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Click="Cancel_Click" />
            <Button DockPanel.Dock="Right" x:Name="LoginButton" Content="Log in" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Login_Click" />
        </DockPanel>
        <TextBlock x:Name="StatusText" Foreground="Gray" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
