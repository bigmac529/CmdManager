<Window x:Class="CmdManager.Client.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CmdManager - Create account" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Create your account" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="ServerText" Foreground="Gray" Margin="0,0,0,12" TextWrapping="Wrap" />

        <TextBlock Text="User name (3-64: letters, digits, . _ - @)" />
        <TextBox x:Name="UserBox" />
        <TextBlock Text="Email (optional)" Margin="0,6,0,0" />
        <TextBox x:Name="EmailBox" />
        <TextBlock x:Name="PasswordLabel" Text="Password" Margin="0,6,0,0" />
        <PasswordBox x:Name="PasswordBox" />
        <TextBlock Text="Confirm password" Margin="0,6,0,0" />
        <PasswordBox x:Name="ConfirmBox" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CreateButton" Content="Create account" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Create_Click" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Foreground="DarkRed" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
