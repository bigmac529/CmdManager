<Window x:Class="CmdManager.Client.Views.ConfirmListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CmdManager" Width="620" Height="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="14">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="OK" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" />
        </StackPanel>
        <ListBox x:Name="Lines" FontFamily="Consolas" />
    </DockPanel>
</Window>
