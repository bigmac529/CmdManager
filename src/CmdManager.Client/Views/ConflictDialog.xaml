<Window x:Class="CmdManager.Client.Views.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CmdManager - Conflict" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock x:Name="PathText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="ReasonText" TextWrapping="Wrap" Margin="0,4,0,8" />
        <TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="Gray" FontFamily="Consolas" Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap" Foreground="Gray"
                   Text="Keep local uploads your file (or deletes the DB copy). Keep server downloads the DB version (or deletes your file). Keep both saves your file as name.conflict.ext, uploads it, and downloads the DB version." />
        <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="LocalButton" Content="Keep local" Click="Local_Click" />
            <Button x:Name="ServerButton" Content="Keep server" Click="Server_Click" />
            <Button x:Name="BothButton" Content="Keep both" Click="Both_Click" />
            <Button Content="Skip" IsCancel="True" Click="Skip_Click" />
        </WrapPanel>
        <CheckBox x:Name="ApplyToAllBox" Content="Use this choice for the remaining conflicts" Margin="0,8,0,0" />
    </StackPanel>
</Window>
