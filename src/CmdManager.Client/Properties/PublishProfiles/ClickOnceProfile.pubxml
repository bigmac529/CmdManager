<?xml version="1.0" encoding="utf-8"?>
<!--
  ClickOnce profile for CmdManager (mirrors bigmac529/SochaDiff desktop/…/ClickOnce.pubxml).

  IIS layout on the web server:
    https://cmdmanager.socha3.com/      → C:\WebApps\CmdManager       static site, app pool CmdManagerWeb (No Managed Code):
                                                                    the ClickOnce files (CmdManager.application, setup.exe,
                                                                    Application Files\...)
    https://cmdmanager.socha3.com/api/  → C:\WebApps\CmdManager\api   IIS application, app pool CmdManager: the API
                                                                    (deployed by .github/workflows/deploy-api.yml)

  Publish from Windows with Visual Studio's MSBuild (`dotnet publish` does not support ClickOnce):
    msbuild src/CmdManager.Client/CmdManager.Client.csproj /restore /t:Publish /p:PublishProfile=ClickOnceProfile /p:CmdManagerBuildNumber=N
  then upload bin\publish\clickonce\ to the SITE ROOT C:\WebApps\CmdManager.

  !! The api\ folder lives inside the site root. A ClickOnce upload must NEVER delete it: always exclude it, e.g.
       robocopy bin\publish\clickonce C:\WebApps\CmdManager /E /XD api
     and never /MIR (or "delete extra files") onto the root without /XD api. Also leave the root web.config alone.

  FRAMEWORK-DEPENDENT win-x64: the .NET 10 Desktop Runtime (x64) is a prerequisite (setup.exe bootstrapper
  installs it from Microsoft when the bootstrapper package is present on the publishing machine).

  Updates: checked before the app starts on every launch (UpdateMode=Foreground) at UpdateUrl. Every published
  version is required (MinimumRequiredVersion = ApplicationVersion), same as SochaDiff.

  Signing: off here. Pass /p:SignManifests=true /p:ManifestCertificateThumbprint=<thumbprint>
  (e.g. the same CN=Socha3 certificate SochaDiff uses). Every release must use the same certificate,
  or installed clients cannot update. Unsigned builds show "Unknown publisher".

  Note: ClickOnce installs into a per-version hashed folder under %LOCALAPPDATA%\Apps\2.0, so the app keeps
  the command folder, settings and tokens in %LOCALAPPDATA%\CmdManager instead (stable across updates).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>

    <PublishProtocol>ClickOnce</PublishProtocol>
    <PublishDir>bin\publish\clickonce\</PublishDir>
    <!-- Site root (static, app pool CmdManagerWeb). The API is the /api child application: never delete it on upload. -->
    <PublishUrl>https://cmdmanager.socha3.com/</PublishUrl>
    <InstallUrl>https://cmdmanager.socha3.com/</InstallUrl>
    <UpdateUrl>https://cmdmanager.socha3.com/</UpdateUrl>
    <InstallFrom>Web</InstallFrom>
    <Install>true</Install>
    <GenerateManifests>true</GenerateManifests>
    <MapFileExtensions>true</MapFileExtensions>
    <CreateWebPageOnPublish>false</CreateWebPageOnPublish>
    <OpenBrowserOnPublish>false</OpenBrowserOnPublish>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <IsWebBootstrapper>true</IsWebBootstrapper>

    <ApplicationVersion>$(CmdManagerApplicationVersion)</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>
    <IsRevisionIncremented>false</IsRevisionIncremented>

    <!-- Check for updates on startup, before the app runs; every published version is required. -->
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>true</UpdateRequired>
    <MinimumRequiredVersion>$(ApplicationVersion)</MinimumRequiredVersion>

    <ProductName>CmdManager</ProductName>
    <PublisherName>Socha3</PublisherName>
    <SuiteName>Socha3</SuiteName>
    <SupportUrl>https://cmdmanager.socha3.com/</SupportUrl>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>

    <SignManifests>false</SignManifests>
    <SkipPublishVerification>false</SkipPublishVerification>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ships with Visual Studio's ClickOnce bootstrapper packages; pass /p:CmdManagerPrereqDotNet=false if missing. -->
    <BootstrapperPackage Include="Microsoft.NetCore.DesktopRuntime.10.0.x64" Condition="'$(CmdManagerPrereqDotNet)' != 'false'">
      <Install>true</Install>
      <ProductName>.NET Desktop Runtime 10.0 (x64)</ProductName>
    </BootstrapperPackage>
  </ItemGroup>
</Project>
